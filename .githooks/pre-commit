#!/bin/bash
# pre-commit —— 拦住"配置/密钥/租户标识符"进仓库
#
# 为什么需要：这个仓库是**公开**的。config.yml 里有 app_secret 和 OCR api_key，
# 一旦提交就是永久泄露（即使之后删除，历史里还在）。
# 2026-09-13 的两次教训（本脚本因此改成两层）：
#   ① 租户标识符早已散落在文档与脚本里，靠事后清理才发现；
#   ② 第一次写的守卫只覆盖"形态"正则，漏了 UUID / 8 位 user_id / 20 位发票号，
#      结果真实值又被写进文档，直到**从远程全新克隆复验**才抓到。
#      → 所以除了形态正则，还从 config.yml 生成**精确黑名单**。
#
# 安装（每个 clone 一次）：
#     git config core.hooksPath .githooks
#     chmod +x .githooks/pre-commit
#
# 临时跳过（确认安全时）：git commit --no-verify
set -uo pipefail

fail() { echo "" >&2; echo "✗ 提交被拒绝：$1" >&2; echo "" >&2; exit 1; }

GITDIR="$(git rev-parse --git-dir)"
ROOT="$(git rev-parse --show-toplevel)"

# ── 0. 刷新精确黑名单（从 config.yml 抽真实值，存 .git/ 下，永不入库）──
if [ -x "$ROOT/finance-router/scripts/gen-blocklist.sh" ]; then
    "$ROOT/finance-router/scripts/gen-blocklist.sh" >/dev/null 2>&1 || true
fi
BLOCKLIST="$GITDIR/secret-blocklist"
EXTRA="$GITDIR/secret-extra"   # 手工维护：不在 config.yml 里的真实值（同样永不入库）

# ── 1. 路径级：这些文件永远不该入库 ─────────────────────────
# ★ 2026-09-21：config\.ya?ml(\.|$) 覆盖 config.yml.bak-* / config.yml.new 这类备份
#   —— 它们同样是明文密钥（实测机器人上就留了一个 config.yml.bak-<ts>）。
#   ⚠ 注意别误伤 config.example.yml：它是要入库的配置文档（`config\.ya?ml` 后面
#   必须是 `.` 或行尾，`config.example.yml` 不匹配，所以不要额外写 example 规则）。
BLOCKED_PATHS='(^|/)config\.ya?ml(\.|$)|(^|/)data/|(^|/)backup/|\.db(-wal|-shm)?$|\.bundle$|(^|/)logs/|\.pem$|(^|/)id_rsa|secret-blocklist'
hits=$(git diff --cached --name-only --diff-filter=ACMR | grep -E "$BLOCKED_PATHS" || true)
if [ -n "$hits" ]; then
    echo "$hits" | sed 's/^/    /' >&2
    fail "上面这些文件属于配置/运行数据，不该进 git（config.yml 含密钥）"
fi

# ── 2. 内容级：只扫暂存内容，跳过二进制 ──────────────────────
added=$(git diff --cached --name-only --diff-filter=ACMR | while read -r f; do
    [ -n "$f" ] && [ -f "$f" ] || continue
    head -c 8000 "$f" | grep -qP '\x00' 2>/dev/null || echo "$f"
done)
[ -n "$added" ] || exit 0

report_and_fail() {
    echo "$1" | head -8 | sed 's/^/    /' >&2
    fail "$2"
}

# ── 2a. 精确值（来自 config.yml）────────────────────────────
for list in "$BLOCKLIST" "$EXTRA"; do
    [ -f "$list" ] || continue
    while IFS= read -r val; do
        [ -n "$val" ] || continue
        bad=$(echo "$added" | xargs -r grep -Fn -- "$val" 2>/dev/null || true)
        [ -n "$bad" ] && report_and_fail "$bad" \
            "命中真实值黑名单（$(echo "$val" | cut -c1-6)…）"
    done < "$list"
done

# ── 2b. 形态（覆盖 config.yml 之外的真实数据：实例号、发票号…）──
PATTERNS=(
    'sk-[A-Za-z0-9]{20,}'                              # OCR / OpenAI 风格 API key
    'app_secret[":= ]+["'"'"']?[A-Za-z0-9]{16,}'        # 飞书 app_secret
    'tbl[A-Za-z0-9]{13,}'                              # 多维表格 table id
    '(od-|ou_)[a-f0-9]{8,}'                            # 部门 / 用户 open id（含截断形式）
    '[a-z0-9]{10,12}\.feishu\.cn'                      # 租户域名
    '[A-Z0-9]{8}-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{12}'  # 实例号 / 定义 code
    # 长数字：发票号等。★ 2026-09-21 加 (?<!widget) —— 飞书表单控件 id 形如
    # widget17893053389170001（17 位），它是**功能必需**（dict 里靠它预填控件），
    # 又不在 config.yml 里，所以不能用精确黑名单放行，只能在这里排除该前缀。
    '(?<!widget)(?<![A-Za-z0-9_.-])[0-9]{15,25}(?![A-Za-z0-9_.-])'
)

# 测试夹具天然需要长数字/示例 UUID（且必须用假值）。所以**形态**正则跳过 _test.go，
# 但**精确黑名单**（上面的 2a）对所有文件生效 —— 真值放进测试一样会被拦。
# 合成夹具：插件侧"命名冻结向量"故意用假发票号（20 位数字），必须放行。
# 这些值与 internal/naming 共用同一份向量，改数字会破坏两端一致性。
added_nontest=$(echo "$added" | grep -v '_test\.go$' \
                | grep -v '^bitable-plugin/testdata/' \
                | grep -v '^bitable-plugin/src/core/cases\.ts$' || true)

for pat in "${PATTERNS[@]}"; do
    bad=$(echo "$added_nontest" | xargs -r grep -nE -- "$pat" 2>/dev/null \
          | grep -v 'cli_9cb844403dbb9108' \
          | grep -v 'cli_9c7cc8a9a9edd105' \
          | grep -v 'feishu\.cn/content/article/' || true)   # 飞书公开帮助文章 URL
    [ -n "$bad" ] && report_and_fail "$bad" "检测到疑似真实标识符/数据（模式: $pat）"
done

# 白名单说明：cli_9cb844403dbb9108 / cli_9c7cc8a9a9edd105 是飞书审批小程序的
# **平台固定 appId**（官方文档公开，所有租户相同），不是本项目 app_id。
exit 0
